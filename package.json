{
  "name": "pi-iteration-diff",
  "version": "0.1.0",
  "description": "Side-by-side net iteration diff viewer and selective prompt feedback for Pi Coding Agent",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/agmonetti/pi-iteration-diff",
  "bugs": {
    "url": "https://github.com/agmonetti/pi-iteration-diff/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agmonetti/pi-iteration-diff.git"
  },
  "license": "MIT",
  "author": "Agustin Monetti",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
